ok   (char *)syscall(SYS_brk, 0) == top
ok   (char *)syscall(SYS_brk, 1) == top
ok   p != MAP_FAILED
ok   p[0] == 0 && p[len - 1] == 0
ok   good
ok   munmap(p, len) == 0
ok   munmap(p, len) == 0
ok   r != MAP_FAILED
ok   mprotect(r, 4096, PROT_READ | PROT_WRITE) == 0
ok   r[100] == 'x'
ok   munmap(r, 4096) == 0
ok   f == want
ok   munmap(f, 8192) == 0
ok   mmap(NULL, 0, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0) == MAP_FAILED && errno == EINVAL
ok   big != NULL
ok   good
