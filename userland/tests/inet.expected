ok   u1 >= 0 && u2 >= 0
ok   opt(u1, SOL_SOCKET, SO_TYPE) == SOCK_DGRAM
ok   bind(u1, (struct sockaddr *)&a, sizeof a) == 0
ok   sendto(u2, "ping", 4, 0, (struct sockaddr *)&a, sizeof a) == 4
